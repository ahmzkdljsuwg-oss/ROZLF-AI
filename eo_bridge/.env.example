# Public API key this bridge requires on every data request (X-API-Key).
EO_BRIDGE_KEY=
# Real ExpertOption web session token. Extract it from your own logged-in
# app.expertoption.com session (DevTools > Network > websocket frames).
# Without it the bridge starts but every data endpoint answers 503.
EO_TOKEN=
# EUROPE | INDIA | HONG_KONG | SINGAPORE | UNITED_STATES (or a full wss:// URL)
EO_REGION=EUROPE
# true = demo context, false = real context (read-only either way; no orders)
EO_DEMO=true
# Seconds of history requested per candle fetch
EO_HISTORY_SECONDS=7200
PORT=8080
LOG_LEVEL=INFO
