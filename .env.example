# ROZLF AI — required environment variables
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional: lock the bot to one chat/user id. Leave empty to allow everyone.
TELEGRAM_CHAT_ID=
# Gemini + Mistral AI (optional; the technical engine still works without them)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409
# Required for FOREX/GOLD candles: real Twelve Data key (no demo fallback)
TWELVE_DATA_API_KEY=
# Database: sqlite by default, or a Railway PostgreSQL URL
DATABASE_URL=sqlite+aiosqlite:///./rozlf.db
# Optional: verified ExpertOption SMARTY/index bridge (read-only price feed)
EO_BRIDGE_URL=
EO_BRIDGE_KEY=
# MT5 bridge (Windows PC/VPS running MetaTrader 5). Both values are required.
# Railway cannot host an MT5 terminal; point this at an HTTPS/tunnel address of the bridge.
MT5_BRIDGE_URL=
MT5_BRIDGE_KEY=
# Logging
LOG_LEVEL=INFO
# Scanner
SCANNER_ENABLED=true
SCANNER_INTERVAL_SECONDS=90
SCAN_MARKETS=FOREX,SMARTY,AI,FOOTBALL,LUXURY,CRICKET
MAX_SCAN_SIGNALS=3
MIN_CONFIDENCE=65
VERIFICATION_INTERVAL_SECONDS=20
# Optional health server port (Railway sets PORT automatically)
PORT=

# Subscriptions + owner-only admin bot (required to enable gating)
# ADMIN_BOT_TOKEN: token of a second, separate Telegram bot created with BotFather.
ADMIN_BOT_TOKEN=
# The sole owner is fixed in code (8368948762); this value is informational only.
OWNER_TELEGRAM_IDS=8368948762
# Auto-enabled when ADMIN_BOT_TOKEN is set.
SUBSCRIPTIONS_ENABLED=
