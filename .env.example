# ROZLF AI — required environment variables
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional: lock the bot to one chat/user id. Leave empty to allow everyone.
TELEGRAM_CHAT_ID=
# Mistral AI (optional; the technical engine still works without it)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409
# Optional: Twelve Data key for extra FX candles/quotes (demo endpoint also works)
TWELVE_DATA_API_KEY=
# Database: sqlite by default, or a Railway PostgreSQL URL
DATABASE_URL=sqlite+aiosqlite:///./rozlf.db
# Optional: verified ExpertOption SMARTY/index bridge (read-only price feed)
EO_BRIDGE_URL=
EO_BRIDGE_KEY=
# Logging
LOG_LEVEL=INFO
# Scanner
SCANNER_ENABLED=true
SCANNER_INTERVAL_SECONDS=90
SCAN_MARKETS=FOREX,SMARTY,AI,FOOTBALL,LUXURY,CRICKET
MAX_SCAN_SIGNALS=3
MIN_CONFIDENCE=65
VERIFICATION_INTERVAL_SECONDS=20
# Optional role override for a dedicated UI/web service: web-only (never polls Telegram)
ROZLF_ROLE=
# رابط خدمة البوت التي تملك محرك التحليل (داخلي على Railway أو رابط عام)
# يضبط فقط في خدمة الويب التي تخدم Mini App. لا يمرر أي مفتاح سري.
ENGINE_API_URL=
# مهم: رابط Mini App — يجب ضبطه في خدمة worker على Railway
# اضبطه على رابط خدمة "web" الخاصة بك (مثال: https://web-production-xxxx.up.railway.app)
# إذا تركته فارغاً، يُستخدم الرابط الافتراضي تلقائياً لكن زر 🚀 Open Mini App قد لا يظهر
MINI_APP_URL=
# Optional health server port (Railway sets PORT automatically)
PORT=
