# ROZLF AI — environment template. Copy to .env and fill locally; never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409
MISTRAL_API_BASE=https://api.mistral.ai/v1
AI_RETRIES=1
AI_TIMEOUT_SECONDS=45

# Twelve Data: real Forex/Gold candles (free plan covers a limited set)
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE=https://api.twelvedata.com

# Optional read-only ExpertOption bridge for OTC / SMARTY candles.
# Leave empty to show DATA UNAVAILABLE for OTC and SMARTY instead of inventing prices.
EO_BRIDGE_URL=
EO_BRIDGE_KEY=

DATABASE_URL=sqlite+aiosqlite:///./data/rozlf.db
LOG_LEVEL=INFO
PORT=8080

SCANNER_INTERVAL_SECONDS=90
MIN_SIGNAL_SCORE=62
MAX_SIGNALS_PER_SCAN=3
SIGNAL_COOLDOWN_MINUTES=45
DEFAULT_EXPIRY_SECONDS=300
